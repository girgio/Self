    "msg":"Wait, there were 5 beds in that room.",
    "img":noone,
    "voice": Dialoghi_femmine
},
{
    "name":"Elijah",
    "msg":"No...",
    "img":noone,
    "voice": Dialoghi_maschi
},
{
