
dialogo_iniziale_ENG =[
{
    "name":"Elijah",
    "msg":"What the fuck is this place?!",
    "img":noone,
    "voice": Dialoghi_maschi
},
{
    "name":"Karl",
    "msg":"Is everyone good? I'm an Innate, I'm specialized in healing spells.",
    "img":noone,
    "voice": Dialoghi_maschi
},
{
    "name":"Andrea",
    "msg":"Keep your magic away from me, I've survived worse.",
    "img":noone,
    "voice": Dialoghi_femmine    
},
{
    "name":"Elijah",
    "msg":"Haha...",
    "img":noone,
    "voice": Dialoghi_maschi
},
{
    "name":"Andrea",
    "msg":"What's so funny?",
    "img":noone,
    "voice": Dialoghi_femmine
},
{
    "name":"Elijah",
    "msg":"Rejecting help from an Innate just because you can't cast magic? Pathetic.",
    "img":noone,
    "voice": Dialoghi_maschi
},
{   "name":"Andrea",
    "msg":"I don't need magic...",//Donato is a genius(also me)
