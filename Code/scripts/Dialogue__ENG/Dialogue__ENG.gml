
dialogo_iniziale_ENG =[
{
    "name":"Elijah",
    "msg":"What the fuck is this place?!",
    "img":noone
},
{
    "name":"Karl",
    "msg":"Is everyone good? I'm an Innate, I'm specialized in healing spells",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"Keep your magic away from me, I've survived worse",
    "img":noone    
},
{
    "name":"Elijah",
    "msg":"Haha...",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"What's so funny?",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"Rejecting help from an Innate just because you can't cast magic? Pathetic",
    "img":noone
},
{   "name":"Andrea",
    "msg":"I don't need magic...",//Donato is a genius(also me)
    "img":noone
},
{ 
    "name":"Karl",
    "msg":"No need to argue. Everyone has their own strengths",
    "img":noone
},
{
    "name":"Isabelle",
    "msg":"Are you really fighting right now? In this mess? We work together, or we don't make it out alive.",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"You're right...",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"I'm Elijah, I'm an Innate",
    "img":noone
},
{
    "name":"Karl",
    "msg":"My name is Karl. As I mentioned, I'm an Innate as well",
    "img":noone
},
{
    "name":"Isabelle",
    "msg":"The name's Isabelle, I'm a Mage",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"Fantastic. I'm surrounded by kids playing with sticks",
    "img":noone
},
{
    "name":"Isabelle",
    "msg":"Right... and you are?",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"Andrea...",
    "img":noone
},
{
    "name":"Karl",
    "msg":"Alright, now that introductions are out of the way, we need to find someone from the Resistance",
    "img":noone
},
{
    "name":"Karl",
    "msg":"I believe the experiment wasn't particularly successful",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"Impressive, coming from a brain soaked in magic",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"Wait... what experiment?",
    "img":noone
},
{
    "name":"Karl",
    "msg":"Oh... I'm sorry, you were brought here against your will",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"...",
    "img":noone
},
{
    "name":"Karl",
    "msg":"Something wrong, Elijah?",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"My sister... we were together before this",
    "img":noone
},
{
    "name":"Isabelle",
    "msg":"Maybe she...",
    "img":noone
},
{
    "name":"Isabelle",
    "msg":"Wait, there were 5 beds in that room",
    "img":noone
},
{
    "name":"Elijah",
    "msg":"No...",
    "img":noone
},
{
    "name":"Karl",
    "msg":"Her body is not there, Elijah. I'm sure she's fine",
    "img":noone
},
{
    "name":"Andrea",
    "msg":"Can we get a move on? I don't want to waste any more time.",
    "img":noone
},
